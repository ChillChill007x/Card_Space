PORT=3000
# Required for `npm start`: the server refuses to start without it.
# Use `npm run demo` for the in-memory demo (data resets on restart).
# `npm run seed:demo` adds the sample cards to MongoDB (never done automatically).
# AUTO_COMPLETE_DAYS=7  (days after shipping before an order auto-completes)
# CONTACT_EMAIL=support@example.com  (shown on the #/contact page)
# MONGODB_URI=mongodb://127.0.0.1:27017/cardspace
# Set both values to bootstrap an administrator. No default password.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-at-least-12-characters
